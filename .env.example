# 复制为 .env 后按需修改；环境变量优先级高于此文件。
# Copy to .env and edit; real environment variables always win.

# ── Workbench ──
# WORKBENCH_PORT=5000
# WORKBENCH_HOST=127.0.0.1
# WORKBENCH_PRIVATE_ROOT=.private/academic-selection

# ── Dev workbench ──
# ACADEMIC_BROWSER_DEBUG_PORT=9222
# ACADEMIC_WORKBENCH_DEV_DIAGNOSTICS=0

# ── Course progress ──
# PROGRESS_PROFILE_ROOT=.private/course-progress

# ── Lab booking (cas-book) ──
# CAS_BOOK_BASE_URL=http://openlab.hitwh.edu.cn
# CAS_BOOK_LOGIN_TIMEOUT=180
# CAS_BOOK_POLL_INTERVAL=5
# CAS_BOOK_MAX_POLL_MINUTES=120

# ── Browser / CDP ──
# ACADEMIC_BROWSER_CDP_URL=http://127.0.0.1:9222
