# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool and test caches
.pytest_cache/
.ruff_cache/
.uv-cache/
.codegraph/

# Playwright session state (contains auth tokens)
storage_state.json
*.har

# Generated booking results
*.xlsx

# User schedule data (personal info)
*.xls

# Original reference documents (kept locally under .private/reference/)
docs/*.docx
docs/*.doc

# Windows redirect artifacts
nul

# Playwright MCP logs
.playwright-mcp/
.playwright-cli/

# Playwright screenshots from exploration
*.png

# Private browser profiles and captured portal data
.private/

# Frontend dependencies and TypeScript build output
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Local tool artifacts (agent sessions, design critiques, runtime logs)
.omo/
.pi/subagents/
.impeccable/
.scratch/verify/
.scratch/academic-browser-observer/eval-results/

# Local environment overrides (may contain secrets)
.env
